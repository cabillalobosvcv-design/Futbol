{
  "entities": {
    "Organization": {
      "title": "Organization",
      "description": "Organización o liga deportiva administradora en SIGD.",
      "type": "object",
      "properties": {
        "name": { "type": "string", "minLength": 2, "maxLength": 120 },
        "shortName": { "type": "string", "minLength": 2, "maxLength": 24 },
        "city": { "type": "string", "maxLength": 80 },
        "logoUrl": { "type": "string", "maxLength": 500 },
        "active": { "type": "boolean" },
        "createdBy": { "type": "string", "pattern": "^[a-zA-Z0-9_\\-]+$", "maxLength": 128 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "shortName", "active", "createdBy", "createdAt", "updatedAt"]
    },
    "UserProfile": {
      "title": "UserProfile",
      "description": "Perfil de usuario y rol RBAC en SIGD.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "pattern": "^[a-zA-Z0-9_\\-]+$", "maxLength": 128 },
        "displayName": { "type": "string", "minLength": 1, "maxLength": 120 },
        "email": { "type": "string", "format": "email", "maxLength": 160 },
        "photoUrl": { "type": "string", "maxLength": 500 },
        "role": {
          "type": "string",
          "enum": ["admin_general", "admin_deportivo", "coordinador", "arbitro", "representante", "publico"]
        },
        "assignedCategoryIds": { "type": "array", "description": "Máximo 20 categorías asignadas." },
        "assignedTeamId": { "type": "string", "maxLength": 128 },
        "refereeId": { "type": "string", "maxLength": 128 },
        "active": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "displayName", "email", "role", "active", "createdAt", "updatedAt"]
    },
    "Sport": {
      "title": "Sport",
      "description": "Disciplina deportiva del catálogo extensible multideporte.",
      "type": "object",
      "properties": {
        "key": { "type": "string", "pattern": "^[a-z0-9_\\-]+$", "maxLength": 40 },
        "name": { "type": "string", "minLength": 2, "maxLength": 80 },
        "engineType": { "type": "string", "enum": ["football", "basketball", "volleyball", "baseball", "athletics", "racquet", "generic"] },
        "periodsCount": { "type": "integer" },
        "periodLabel": { "type": "string", "maxLength": 40 },
        "allowDraws": { "type": "boolean" },
        "statSchema": { "type": "array" },
        "active": { "type": "boolean" },
        "isPrimary": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["key", "name", "engineType", "periodsCount", "allowDraws", "active", "createdAt", "updatedAt"]
    },
    "SportRule": {
      "title": "SportRule",
      "description": "Reglamento configurable por deporte o torneo.",
      "type": "object",
      "properties": {
        "sportId": { "type": "string", "pattern": "^[a-zA-Z0-9_\\-]+$", "maxLength": 128 },
        "name": { "type": "string", "minLength": 2, "maxLength": 120 },
        "winPoints": { "type": "integer" },
        "drawPoints": { "type": "integer" },
        "lossPoints": { "type": "integer" },
        "tiebreakers": { "type": "array" },
        "minRestHours": { "type": "integer" },
        "matchDurationMinutes": { "type": "integer" },
        "maxPlayersOnField": { "type": "integer" },
        "yellowCardsSuspensionLimit": { "type": "integer" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["sportId", "name", "winPoints", "drawPoints", "lossPoints", "tiebreakers", "minRestHours", "updatedAt"]
    },
    "Season": {
      "title": "Season",
      "description": "Temporada deportiva histórica o vigente.",
      "type": "object",
      "properties": {
        "name": { "type": "string", "minLength": 2, "maxLength": 100 },
        "year": { "type": "integer" },
        "startDate": { "type": "string", "maxLength": 20 },
        "endDate": { "type": "string", "maxLength": 20 },
        "status": { "type": "string", "enum": ["planificada", "activa", "finalizada"] },
        "createdBy": { "type": "string", "pattern": "^[a-zA-Z0-9_\\-]+$", "maxLength": 128 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "year", "startDate", "endDate", "status", "createdBy", "createdAt", "updatedAt"]
    },
    "Tournament": {
      "title": "Tournament",
      "description": "Torneo competitivo independiente dentro de una temporada.",
      "type": "object",
      "properties": {
        "name": { "type": "string", "minLength": 2, "maxLength": 140 },
        "sportId": { "type": "string", "pattern": "^[a-zA-Z0-9_\\-]+$", "maxLength": 128 },
        "seasonId": { "type": "string", "pattern": "^[a-zA-Z0-9_\\-]+$", "maxLength": 128 },
        "organizationId": { "type": "string", "maxLength": 128 },
        "format": { "type": "string", "enum": ["round_robin", "knockout", "groups", "mixed"] },
        "doubleRound": { "type": "boolean" },
        "teamsPerGroup": { "type": "integer" },
        "qualifiersPerGroup": { "type": "integer" },
        "winPoints": { "type": "integer" },
        "drawPoints": { "type": "integer" },
        "lossPoints": { "type": "integer" },
        "tiebreakers": { "type": "array" },
        "minRestHours": { "type": "integer" },
        "schedulePublished": { "type": "boolean" },
        "status": { "type": "string", "enum": ["borrador", "inscripciones", "en_curso", "finalizado", "suspendido"] },
        "championTeamId": { "type": "string", "maxLength": 128 },
        "championTeamName": { "type": "string", "maxLength": 120 },
        "startDate": { "type": "string", "maxLength": 20 },
        "endDate": { "type": "string", "maxLength": 20 },
        "createdBy": { "type": "string", "pattern": "^[a-zA-Z0-9_\\-]+$", "maxLength": 128 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "sportId", "seasonId", "format", "winPoints", "drawPoints", "lossPoints", "tiebreakers", "schedulePublished", "status", "createdBy", "createdAt", "updatedAt"]
    },
    "Branch": {
      "title": "Branch",
      "description": "Rama competitiva (Varonil, Femenil, Mixta).",
      "type": "object",
      "properties": {
        "name": { "type": "string", "minLength": 2, "maxLength": 60 },
        "code": { "type": "string", "maxLength": 16 }
      },
      "required": ["name", "code"]
    },
    "Category": {
      "title": "Category",
      "description": "Categoría competitiva dentro de un torneo.",
      "type": "object",
      "properties": {
        "tournamentId": { "type": "string", "pattern": "^[a-zA-Z0-9_\\-]+$", "maxLength": 128 },
        "branchId": { "type": "string", "maxLength": 128 },
        "branchName": { "type": "string", "maxLength": 60 },
        "name": { "type": "string", "minLength": 2, "maxLength": 100 },
        "minAge": { "type": "integer" },
        "maxAge": { "type": "integer" },
        "coordinatorUid": { "type": "string", "maxLength": 128 },
        "schedulePublished": { "type": "boolean" },
        "championTeamId": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["tournamentId", "name", "schedulePublished", "createdAt", "updatedAt"]
    },
    "Team": {
      "title": "Team",
      "description": "Equipo inscrito en un torneo y categoría.",
      "type": "object",
      "properties": {
        "tournamentId": { "type": "string", "pattern": "^[a-zA-Z0-9_\\-]+$", "maxLength": 128 },
        "categoryId": { "type": "string", "pattern": "^[a-zA-Z0-9_\\-]+$", "maxLength": 128 },
        "name": { "type": "string", "minLength": 2, "maxLength": 100 },
        "shortCode": { "type": "string", "minLength": 2, "maxLength": 6 },
        "primaryColor": { "type": "string", "maxLength": 20 },
        "secondaryColor": { "type": "string", "maxLength": 20 },
        "crestUrl": { "type": "string", "maxLength": 500 },
        "coachId": { "type": "string", "maxLength": 128 },
        "coachName": { "type": "string", "maxLength": 100 },
        "representativeUid": { "type": "string", "maxLength": 128 },
        "groupId": { "type": "string", "maxLength": 128 },
        "active": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["tournamentId", "categoryId", "name", "shortCode", "primaryColor", "active", "createdAt", "updatedAt"]
    },
    "Player": {
      "title": "Player",
      "description": "Jugador registrado en un equipo.",
      "type": "object",
      "properties": {
        "tournamentId": { "type": "string", "pattern": "^[a-zA-Z0-9_\\-]+$", "maxLength": 128 },
        "categoryId": { "type": "string", "pattern": "^[a-zA-Z0-9_\\-]+$", "maxLength": 128 },
        "teamId": { "type": "string", "pattern": "^[a-zA-Z0-9_\\-]+$", "maxLength": 128 },
